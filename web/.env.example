# Copy to .env.local for local runs; set the same variables in Vercel → Project → Settings → Environment Variables.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
# Use the read-only role once its password is set (ALTER ROLE cfb_web PASSWORD '...').
PGUSER=cfb_web
PGPASSWORD=
# Login gate: AUTH_SECRET must be 32+ random characters.
AUTH_SECRET=
APP_USERNAME=
APP_PASSWORD=
DEFAULT_TEAM=Georgia
